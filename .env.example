# Copy to .env (extension root) for local development. Only read when the
# extension runs in Development mode (F5). Never commit or package .env.
OPENROUTER_API_KEY=
# Optional: preselect a model during development (any id from /api/v1/models)
OPENROUTER_DEFAULT_MODEL=
# Optional: point at a mock server for tests
OPENROUTER_BASE_URL=